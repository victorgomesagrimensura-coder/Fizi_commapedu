{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fizi-school-commap-tec",
  "main": "src/worker.py",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["python_workers"],
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_HYPERDRIVE_CONFIG_ID"
    }
  ]
}
